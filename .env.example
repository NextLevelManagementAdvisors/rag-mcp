# --- Storage (PostgreSQL + pgvector) ---
# POSTGRES_PASSWORD is also read by docker-compose.yml to set the db
# container's password — keep it in sync with DATABASE_URL below, and set a
# real secret here for any host beyond local dev (a leaked docker-compose.yml
# should not also leak the deployed credential).
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag

# --- Embeddings ---
# EMBEDDINGS_PROVIDER=local  → in-process ONNX via fastembed. No API key, no
#   external service. Set EMBEDDINGS_MODEL to a fastembed-supported model and
#   EMBED_DIM to its dimension (all-MiniLM-L6-v2 → 384).
# EMBEDDINGS_PROVIDER=openai → any OpenAI-compatible /embeddings endpoint.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_API_BASE=https://api.openai.com/v1
EMBEDDINGS_API_KEY=sk-replace-me
EMBEDDINGS_MODEL=text-embedding-3-small
EMBED_DIM=1536            # must match the embedding model's output dimension

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Transport: "stdio" (local Claude Desktop) or "http" (hosted) ---
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=3050

# --- OAuth 2.1 via Google sign-in (HTTP transport; optional) ---
# Set these to front the server with OAuth 2.1 (DCR + PKCE) + "Sign in with
# Google". Register a GCP web OAuth client whose redirect URI is
# <MCP_BASE_URL>/auth/callback. Only GOOGLE_ALLOWED_EMAILS may sign in
# (fail-closed: empty = nobody).
MCP_BASE_URL=https://rag.example.com
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=you@example.com
